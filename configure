#!/bin/sh
# configure: probe this device's kernel capabilities empirically and write
# config.env, which install.sh consumes (./configure && ./install.sh, like
# ./configure && make install). Re-run anytime; install.sh reconciles the
# system to match. FORCE_PASTA=1 ./configure forces the pasta route even on
# kernels where the native netavark bridge would work (shim regression tests).
set -e
cd "$(dirname "$0")"

CONF=config.env
P=/tmp/doa-cfg

# namespaces: /proc/self/ns/<n> exists only when the kernel has it
ns_user=0; ns_ipc=0; ns_pid=0
[ -e /proc/self/ns/user ] && ns_user=1
[ -e /proc/self/ns/ipc ] && ns_ipc=1
[ -e /proc/self/ns/pid ] && ns_pid=1

# veth + bridge: create throwaway links (autoloads the modules if modular)
veth=0; bridge=0
if ip link add doa-cfg-v0 type veth peer name doa-cfg-v1 2>/dev/null; then
  veth=1; ip link del doa-cfg-v0 2>/dev/null
fi
if ip link add doa-cfg-br type bridge 2>/dev/null; then
  bridge=1; ip link del doa-cfg-br 2>/dev/null
fi

# firewall: probe the exact binary netavark would exec, and whether it can
# install the rule shapes netavark emits — hostport DNAT needs xt_addrtype,
# UDP ports need xt CHECKSUM, NAT needs conntrack/comment/MASQUERADE; Android
# kernels often trim xt matches even when tables exist. If no legacy userspace
# binary is present but the kernel has legacy tables registered
# (/proc/net/ip_tables_names), install the tiny iptables-legacy package now —
# without it the decision below would be a guess.
fw=none; fw_legacy_shim=0; fw_legacy_bin=
ipt=
det_legacy() {
  for c in iptables-legacy xtables-legacy-multi; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -t nat -L >/dev/null 2>&1; then
      ipt=$c; fw_legacy_shim=1; fw_legacy_bin=$(command -v "$c"); return 0
    fi
  done
  return 1
}
if command -v nft >/dev/null 2>&1 && nft list ruleset >/dev/null 2>&1; then
  fw=nftables
else
  if command -v iptables >/dev/null 2>&1 && iptables -t nat -L >/dev/null 2>&1; then
    ipt=iptables
  elif ! det_legacy && grep -qw nat /proc/net/ip_tables_names 2>/dev/null; then
    echo "> installing iptables-legacy (kernel has legacy tables but no userspace binary)"
    if command -v apk >/dev/null 2>&1; then apk add iptables-legacy
    elif command -v dnf >/dev/null 2>&1; then dnf install -y iptables-legacy
    elif command -v apt-get >/dev/null 2>&1; then apt-get update && apt-get install -y iptables
    fi
    det_legacy || true
  fi
  if [ -n "$ipt" ]; then
    if "$ipt" -t nat -N DOA_CFG 2>/dev/null \
    && "$ipt" -t nat -A DOA_CFG -m conntrack --ctstate ESTABLISHED -m comment --comment doa -j RETURN 2>/dev/null \
    && "$ipt" -t nat -A DOA_CFG -m addrtype --dst-type LOCAL -j RETURN 2>/dev/null \
    && "$ipt" -t nat -A POSTROUTING -s 127.255.255.255/32 -j MASQUERADE 2>/dev/null \
    && "$ipt" -t mangle -N DOA_CFG_M 2>/dev/null \
    && "$ipt" -t mangle -A DOA_CFG_M -p udp -j CHECKSUM --checksum-fill 2>/dev/null; then
      fw=iptables
      "$ipt" -t nat -D POSTROUTING -s 127.255.255.255/32 -j MASQUERADE 2>/dev/null
    fi
    "$ipt" -t nat -F DOA_CFG 2>/dev/null || true
    "$ipt" -t nat -X DOA_CFG 2>/dev/null || true
    "$ipt" -t mangle -F DOA_CFG_M 2>/dev/null || true
    "$ipt" -t mangle -X DOA_CFG_M 2>/dev/null || true
  fi
fi

# overlayfs: real mount test (mkdir one by one: busybox sh has no {a,b})
storage=vfs
rm -rf "$P"; mkdir -p "$P"; mkdir "$P/l" "$P/u" "$P/w" "$P/m"
if mount -t overlay overlay -o "lowerdir=$P/l,upperdir=$P/u,workdir=$P/w" "$P/m" 2>/dev/null; then
  storage=overlay; umount "$P/m"
fi
rm -rf "$P"

# loopback already configured?
lo_fix=1
ip addr show dev lo 2>/dev/null | grep -q 'inet 127\.' && lo_fix=0

# route selection
route=pasta
if [ "${FORCE_PASTA:-0}" != 1 ] && [ "$veth" = 1 ] && [ "$bridge" = 1 ] && [ "$fw" != none ]; then
  route=native
fi

podman_wrapper=0; [ "$ns_user" = 0 ] && podman_wrapper=1
crun_nomq=0; [ "$ns_ipc" = 0 ] && crun_nomq=1
need_jq=0
if [ "$route" = pasta ] || [ "$crun_nomq" = 1 ]; then need_jq=1; fi

cat > "$CONF" <<EOF
# generated by ./configure; consumed by install.sh. re-run ./configure to regenerate.
NET_ROUTE=$route
FW_DRIVER=$fw
IPTABLES_LEGACY_SHIM=$fw_legacy_shim
IPTABLES_LEGACY_BIN=$fw_legacy_bin
STORAGE_DRIVER=$storage
PODMAN_WRAPPER=$podman_wrapper
CRUN_NOMQ=$crun_nomq
IPCNS=$([ "$ns_ipc" = 1 ] && echo private || echo host)
PIDNS=$([ "$ns_pid" = 1 ] && echo private || echo host)
LO_FIX=$lo_fix
NEED_JQ=$need_jq
EOF

echo "probes:   userns=$ns_user ipcns=$ns_ipc pidns=$ns_pid veth=$veth bridge=$bridge overlayfs=$([ "$storage" = overlay ] && echo 1 || echo 0) lo_ok=$((1-lo_fix))"
echo "config:   route=$route fw=$fw legacy_shim=$fw_legacy_shim storage=$storage podman_wrapper=$podman_wrapper crun_nomq=$crun_nomq jq=$need_jq"
[ "$route" = pasta ] && [ ! -f rootfs/usr/local/bin/pasta ] && \
  echo "note:     pasta route selected but no binary; run ./build-pasta.sh before ./install.sh"
echo "wrote $CONF — now run ./install.sh"
