#!/bin/sh
# DockerOnAndroid podman wrapper: real binary is /usr/bin/podman.real (see install.sh).
# - export env podman needs on this kernel
# - drop the noisy "Failed to read current user namespace mappings" warning
#   that every rootful call prints on a kernel without user namespaces
# - with a fuse-overlayfs mount_program, containers/storage falls back to
#   naive diff and every per-step COMMIT walks both trees; DOA_BUILD_SQUASH=1
#   appends --squash to skip the intermediate commits (~30% off cold builds).
#   Squashed output keeps no intermediate layers, so it neither uses nor
#   produces build cache — opt in for one-shot/final builds only.
# - stop/rm right after container exit can race fuse-overlayfs teardown and
#   fail EBUSY on the merged mount; retry once after a beat. stop is
#   idempotent on an already-stopped container, so the retry is safe.
case "${1:-}" in
  build|bud)
    case " $* " in *" --squash"*) :;; *)
      [ "${DOA_BUILD_SQUASH:-0}" = 1 ] && set -- "$@" --squash
    ;; esac
    ;;
  rm|stop)
    err=$(mktemp /tmp/podman.err.XXXXXX) || exec /usr/bin/podman.real "$@"
    /usr/bin/podman.real "$@" 2>"$err"; rc=$?
    if [ "$rc" -ne 0 ] && grep -q "device or resource busy" "$err"; then
      sleep 0.5
      : > "$err"
      /usr/bin/podman.real "$@" 2>"$err"; rc=$?
    fi
    grep -v "Failed to read current user namespace mappings" "$err" >&2
    rm -f "$err"
    exit "$rc"
    ;;
esac
export PODMAN_IGNORE_CGROUPSV1_WARNING=1
fifo=$(mktemp -u /tmp/podman.err.XXXXXX) || exec /usr/bin/podman.real "$@"
mkfifo "$fifo" || exec /usr/bin/podman.real "$@"
grep -v "Failed to read current user namespace mappings" < "$fifo" >&2 &
gp=$!
/usr/bin/podman.real "$@" 2>"$fifo"
rc=$?
wait "$gp" 2>/dev/null || true
rm -f "$fifo"
exit "$rc"
