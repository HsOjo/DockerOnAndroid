#!/bin/sh
# configure: probe this device's kernel capabilities empirically and write
# config.env, which install.sh consumes (./configure && ./install.sh, like
# ./configure && make install). Re-run anytime; install.sh reconciles the
# system to match.
set -e
cd "$(dirname "$0")"

CONF=config.env
P=/tmp/doa-cfg

# namespaces: /proc/self/ns/<n> exists only when the kernel has it
ns_user=0; ns_ipc=0; ns_pid=0; ns_uts=0
[ -e /proc/self/ns/user ] && ns_user=1
[ -e /proc/self/ns/ipc ] && ns_ipc=1
[ -e /proc/self/ns/pid ] && ns_pid=1
[ -e /proc/self/ns/uts ] && ns_uts=1

# overlayfs: real mount test (mkdir one by one: busybox sh has no {a,b})
storage=vfs
rm -rf "$P"; mkdir -p "$P"; mkdir "$P/l" "$P/u" "$P/w" "$P/m"
if mount -t overlay overlay -o "lowerdir=$P/l,upperdir=$P/u,workdir=$P/w" "$P/m" 2>/dev/null; then
  storage=overlay; umount "$P/m"
elif [ -c /dev/fuse ]; then
  # no kernel overlayfs: userspace overlay still beats vfs' full-tree copy
  # per layer/step. install.sh pkg-installs fuse-overlayfs when missing.
  storage=fuse-overlayfs
fi
rm -rf "$P"

# renameat2: kernels < 3.15 lack the syscall, and fuse-overlayfs' plain-rename
# path calls renameat2 with no ENOSYS fallback, so every rename inside a
# container fails (apt, corepack, ...). Probe the syscall table; when it is
# unreadable we err toward the patch (the fallback is harmless everywhere).
fov_patch=0
if [ "$storage" = fuse-overlayfs ] && ! grep -q renameat2 /proc/kallsyms 2>/dev/null; then
  fov_patch=1
fi

# loopback already configured?
lo_fix=1
ip addr show dev lo 2>/dev/null | grep -q 'inet 127\.' && lo_fix=0

# /proc/thread-self: kernels < 3.17 lack it; podman gets a binary patch
# (patches/podman/thread-self.py) pointing at the doa-tsd FUSE shim instead
ts_fix=0
[ -e /proc/thread-self ] || ts_fix=1

# cgroup v1 controllers mounted anywhere under /sys/fs/cgroup? mounts made by
# our own doa-cgroups service don't count — without the service nothing would
# mount them at boot, so a previous install must not flip this probe to 0
cgroup_fix=1
if grep -q '^cgroup ' /proc/mounts && [ ! -e /etc/init.d/doa-cgroups ]; then
  cgroup_fix=0
fi

# memory controller compiled in? crun kill --all hardcodes /sys/fs/cgroup/memory
memcg=0; grep -q '^memory' /proc/cgroups && memcg=1

# hybrid kernels: the v2 root may lack pids while v1 has it; crun hard-fails
# writing pids.max against cgroup.controllers there
pids_v2=1
if [ -f /sys/fs/cgroup/cgroup.controllers ] && ! grep -qw pids /sys/fs/cgroup/cgroup.controllers \
   && grep -q '^pids' /proc/cgroups; then
  pids_v2=0
fi

# cpuset writable? Android 3.x kernels pin the root cpuset (0-N) and refuse
# child writes (EINVAL), which is fatal to upstream crun
cpuset_ok=1
if [ -f /sys/fs/cgroup/cpuset/cpuset.cpus ]; then
  cps=/sys/fs/cgroup/cpuset/.doa-cfg
  if mkdir "$cps" 2>/dev/null; then
    cat /sys/fs/cgroup/cpuset/cpuset.mems > "$cps/cpuset.mems" 2>/dev/null && \
    cat /sys/fs/cgroup/cpuset/cpuset.cpus > "$cps/cpuset.cpus" 2>/dev/null || cpuset_ok=0
    rmdir "$cps" 2>/dev/null
  fi
fi

crun_patch=0
{ [ "$memcg" = 0 ] || [ "$cpuset_ok" = 0 ] || [ "$pids_v2" = 0 ]; } && crun_patch=1

# native bridge networking: usable when the kernel can do veth+bridge plus
# NAT via a firewall driver netavark supports. Probe empirically by having
# netavark itself set up a throwaway netns — the exact component and code
# path production containers would use. Falls back to the pasta shim (works
# with just NET_NS+TUN) when anything is missing.
net_backend=pasta
net_fwdriver=
nv=
for d in /usr/libexec/podman /usr/lib/podman; do
  # prefer the pristine binary: netavark may already be the DoA wrapper
  [ -f "$d/netavark.real" ] && { nv=$d/netavark.real; break; }
  [ -z "$nv" ] && [ -f "$d/netavark" ] && ! grep -q DockerOnAndroid "$d/netavark" 2>/dev/null && nv=$d/netavark
done
if [ -n "$nv" ] && command -v unshare >/dev/null 2>&1; then
  modprobe bridge veth nf_tables nf_nat ip_tables iptable_nat ip6_tables ip6table_nat 2>/dev/null
  # netavark shells out to the nft/iptables binaries for its rules; native
  # needs one at runtime anyway, so install iptables here or a machine
  # without either can never probe native (iptables covers kernels without
  # NFT_FIB_INET, where netavark's nft hostport fib rules fail)
  if ! command -v nft >/dev/null 2>&1 && ! command -v iptables >/dev/null 2>&1; then
    if command -v apk >/dev/null 2>&1; then apk add iptables >/dev/null 2>&1
    elif command -v apt-get >/dev/null 2>&1; then apt-get update >/dev/null 2>&1 && apt-get install -y iptables >/dev/null 2>&1
    elif command -v dnf >/dev/null 2>&1; then dnf install -y iptables >/dev/null 2>&1
    elif command -v pacman >/dev/null 2>&1; then pacman -Sy --noconfirm iptables >/dev/null 2>&1
    fi
  fi
  NP=/tmp/doa-cfg/netprobe
  cat > /tmp/doa-cfg-probe.json <<'EOF'
{"container_id":"doaprobe","container_name":"doaprobe","port_mappings":[],"networks":{"doaprobe":{"static_ips":["10.250.0.2"],"interface_name":"eth0"}},"network_info":{"doaprobe":{"name":"doaprobe","id":"doaprobe0","driver":"bridge","network_interface":"doaprobe0","subnets":[{"subnet":"10.250.0.0/24","gateway":"10.250.0.1"}],"ipv6_enabled":false,"internal":false,"dns_enabled":false}}}
EOF
  for fwd in nftables iptables; do
    [ "$net_backend" = pasta ] || break
    case $fwd in
      nftables) command -v nft >/dev/null 2>&1 || continue;;
      iptables) command -v iptables >/dev/null 2>&1 || continue;;
    esac
    rm -rf "$NP"; mkdir -p "$NP"
    unshare -n sleep 20 & np_pid=$!
    sleep 1
    if "$nv" --firewall-driver="$fwd" --config "$NP" setup "/proc/$np_pid/ns/net" < /tmp/doa-cfg-probe.json 2>/dev/null | grep -q '"eth0"'; then
      net_backend=native; net_fwdriver=$fwd
    fi
    "$nv" --firewall-driver="$fwd" --config "$NP" teardown "/proc/$np_pid/ns/net" < /tmp/doa-cfg-probe.json >/dev/null 2>&1 || true
    kill "$np_pid" 2>/dev/null
    rm -rf "$NP"
  done
  rm -f /tmp/doa-cfg-probe.json
fi

# pasta needs TUN (module or built-in); without it the fallback backend is
# useless too, so flag it loudly instead of silently writing config.env
tun_ok=1
if [ "$net_backend" = pasta ]; then
  [ -c /dev/net/tun ] || modprobe tun 2>/dev/null
  [ -c /dev/net/tun ] || tun_ok=0
fi

# small default TCP send buffer: pasta's fallback path advertises the host
# socket's SO_SNDBUF as the guest-side window. The 16K default on 3.x
# kernels makes every guest burst hit a partial sendmsg(); the unsent tail
# is dropped and the guest (no SACK toward pasta, 200ms min RTO) collapses
# into RTO backoff - published ports crawl at KB/s. A >= 256K default keeps
# window < buffer so partial sends don't happen (rootfs/etc/sysctl.d conf).
# pasta-only: native bridge traffic never traverses a host socket.
wmem_fix=0
if [ "$net_backend" = pasta ]; then
  # shellcheck disable=SC2046 # intentional: split tcp_wmem's three fields
  set -- $(cat /proc/sys/net/ipv4/tcp_wmem 2>/dev/null)
  if [ -e /etc/sysctl.d/90-doa-tcp-wmem.conf ]; then
    # our own conf already raised the running value; without it the next boot
    # would be back to the small default, so it must not flip this probe off
    wmem_fix=1
  elif [ -n "$2" ] && [ "$2" -lt 262144 ] 2>/dev/null; then
    wmem_fix=1
  fi
fi

# graphroot: opt in via GRAPHROOT=... ./configure (e.g. when /var/lib is a
# small rootfs and container data belongs on a bigger partition); once set it
# sticks across re-runs, so plain ./configure doesn't silently revert it
graphroot=${GRAPHROOT:-}
if [ -z "$graphroot" ] && [ -f "$CONF" ]; then
  graphroot=$(sed -n 's/^GRAPHROOT=//p' "$CONF")
fi

podman_wrapper=0; [ "$ns_user" = 0 ] && podman_wrapper=1
crun_nomq=0; [ "$ns_ipc" = 0 ] && crun_nomq=1

# aid_inet gid required for sockets? Android's paranoid-network check
# (CONFIG_ANDROID_PARANOID_NETWORK) fails socket() with EACCES unless the
# process carries AID_INET (3003, hardcoded in the kernel; no capability
# bypass, root included). Probe empirically when setpriv+nc are around,
# kernel config text otherwise; unknown errs toward 3003 since the shim's
# chgrp/--runas are harmless where unneeded.
inet_gid=3003
if command -v setpriv >/dev/null 2>&1 && command -v nc >/dev/null 2>&1; then
  if setpriv --clear-groups nc -w1 127.0.0.1 1 2>&1 >/dev/null | grep -qi 'permission denied'; then
    inet_gid=3003
  else
    inet_gid=
  fi
else
  case $({ zcat /proc/config.gz 2>/dev/null; cat /boot/config "/boot/config-$(uname -r)" 2>/dev/null; }) in
    *CONFIG_ANDROID_PARANOID_NETWORK=y*) inet_gid=3003 ;;
    *"CONFIG_ANDROID_PARANOID_NETWORK is not set"*) inet_gid= ;;
  esac
fi

cat > "$CONF" <<EOF
# generated by ./configure; consumed by install.sh. re-run ./configure to regenerate.
STORAGE_DRIVER=$storage
PODMAN_WRAPPER=$podman_wrapper
CRUN_NOMQ=$crun_nomq
IPCNS=$([ "$ns_ipc" = 1 ] && echo private || echo host)
PIDNS=$([ "$ns_pid" = 1 ] && echo private || echo host)
UTSNS=$([ "$ns_uts" = 1 ] && echo private || echo host)
LO_FIX=$lo_fix
CGROUP_FIX=$cgroup_fix
TS_FIX=$ts_fix
CRUN_PATCH=$crun_patch
FOV_PATCH=$fov_patch
WMEM_FIX=$wmem_fix
NET_BACKEND=$net_backend
NET_FWDRIVER=$net_fwdriver
INET_GID=$inet_gid
GRAPHROOT=$graphroot
EOF

echo "probes:   userns=$ns_user ipcns=$ns_ipc pidns=$ns_pid utsns=$ns_uts overlayfs=$([ "$storage" = overlay ] && echo 1 || echo 0) lo_ok=$((1-lo_fix)) cgroup_ok=$((1-cgroup_fix)) thread_self=$((1-ts_fix)) memcg=$memcg cpuset_ok=$cpuset_ok pids_v2=$pids_v2 tun=$tun_ok inet_gid=${inet_gid:-none}"
echo "config:   storage=$storage backend=$net_backend${net_fwdriver:+($net_fwdriver)} podman_wrapper=$podman_wrapper crun_nomq=$crun_nomq crun_patch=$crun_patch fov_patch=$fov_patch ts_fix=$ts_fix"
[ "$net_backend" = pasta ] && [ ! -f rootfs/usr/local/bin/pasta ] && \
  echo "note:     no pasta binary yet; run ./build-pasta.sh before ./install.sh"
[ "$crun_patch" = 1 ] && [ ! -f rootfs/usr/bin/crun-doa ] && \
  echo "note:     kernel cgroup support is broken; run ./build-crun.sh before ./install.sh"
[ "$fov_patch" = 1 ] && [ ! -f rootfs/usr/bin/fuse-overlayfs-doa ] && \
  echo "note:     kernel has no renameat2; run ./build-fuse-overlayfs.sh before ./install.sh"
[ "$tun_ok" = 0 ] && \
  echo "warn:     no TUN support and native bridge unavailable - no working network backend"
echo "wrote $CONF — now run ./install.sh"
