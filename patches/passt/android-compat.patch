+		if (errno != EINVAL ||
+		    (unshare(flags & ~(CLONE_NEWIPC | CLONE_NEWPID)) &&
+		     (errno != EINVAL ||
+		      unshare(flags & ~(CLONE_NEWIPC | CLONE_NEWPID |
+					CLONE_NEWUTS))))) {
