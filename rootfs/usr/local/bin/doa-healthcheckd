#!/bin/sh
# doa-healthcheckd: per-container healthcheck scheduler for podman on systems
# without systemd. podman delegates healthcheck timing to systemd transient
# timers; without systemd (Android chroots, postmarketOS) a container with a
# HEALTHCHECK stays in "starting" forever and docker compose hangs on
# depends_on: service_healthy. Mirrors docker semantics: each container is
# checked at its own configured interval (default 30s upstream). Docker's
# start-period/start-interval semantics are mirrored (moby daemon/health.go):
# while a container is within its start period and has never passed a check,
# probes run at start-interval (default 5s) instead of interval, so slow-
# starting services are detected healthy quickly.
#
# Event-driven: a persistent 'podman events' stream reports container
# start/stop, and the loop sleeps until the next healthcheck is due, so the
# steady state costs zero podman forks. The tick argument is only a fallback
# resync interval (full 'podman ps' reconciliation) in case the events
# stream silently misses something; podman ps is also run once at startup
# and whenever the events stream has to be restarted.
# usage: doa-healthcheckd [tick-seconds]   (fallback resync interval, default 60)
set -u
tick=${1:-60}
state=/run/doa-healthcheckd
mkdir -p "$state"

# go duration string ("1h30m0s", "30s", "0s") -> seconds
dur_to_s() {
  d=$1 total=0
  case $d in *h*) total=$(( ${d%%h*} * 3600 )); d=${d#*h} ;; esac
  case $d in *m*) total=$(( total + ${d%%m*} * 60 )); d=${d#*m} ;; esac
  case $d in *s*) s=${d%%s*}; total=$(( total + ${s%%.*} )) ;; esac
  echo "$total"
}

# per-container healthcheck timing, fetched with a single inspect and cached:
# echoes "interval-s start-period-s start-interval-s started-epoch"
meta_of() {
  id=$1
  f=$state/$id.meta
  if [ ! -f "$f" ]; then
    meta=$(podman inspect --format '{{.Config.Healthcheck.Interval}} {{.Config.Healthcheck.StartPeriod}} {{.Config.Healthcheck.StartInterval}} {{.State.StartedAt.Unix}}' "$id" 2>/dev/null) || meta=
    if [ -z "$meta" ]; then
      # older podman: Healthcheck has no StartInterval field, template fails
      meta=$(podman inspect --format '{{.Config.Healthcheck.Interval}} 0s 0s {{.State.StartedAt.Unix}}' "$id" 2>/dev/null) || meta="0s 0s 0s 0"
    fi
    # shellcheck disable=SC2086  # intentional word splitting of the 4 fields
    set -- $meta
    echo "$(dur_to_s "${1:-0s}") $(dur_to_s "${2:-0s}") $(dur_to_s "${3:-0s}") ${4:-0}" > "$f"
  fi
  cat "$f"
}

# track a running container; first check is due immediately (mirrors the old
# polling behaviour for a newly discovered container). ids are truncated to
# the 12-char short form: 'podman ps -q' prints short ids while 'podman
# events' reports full ids, and mixed forms would double-track a container.
add_container() {
  set -- "$(printf %.12s "$1")"
  # shellcheck disable=SC2046  # word splitting of the meta fields is intended
  set -- "$1" $(meta_of "$1")
  if [ "$2" -gt 0 ] 2>/dev/null; then
    [ -f "$state/$1.due" ] || date +%s > "$state/$1.due"
  else
    rm -f "$state/$1.due" "$state/$1.meta" "$state/$1.healthy"
  fi
}

remove_container() {
  set -- "$(printf %.12s "$1")"
  rm -f "$state/$1.due" "$state/$1.meta" "$state/$1.healthy"
}

# full reconciliation with podman ps; only run at startup, on events stream
# recovery, and as a tick-interval fallback — never in the steady state
sync_all() {
  # normalize to space-separated so the case match below works regardless of
  # whether ids are separated by spaces or newlines
  ids=" $(podman ps -q 2>/dev/null | tr '\n' ' ') "
  for id in $ids; do
    add_container "$id"
  done
  for f in "$state"/*.due "$state"/*.meta "$state"/*.healthy; do
    [ -e "$f" ] || continue
    id=${f%.*}; id=${id##*/}
    case $ids in
      *" $id "*) ;;
      *) remove_container "$id" ;;
    esac
  done
  lastsync=$(date +%s)
}

# run all healthchecks that are due; echo the earliest next due timestamp
# (0 = nothing scheduled). Probe spacing mirrors moby daemon/health.go: within
# the start period and never-healthy the step is start-interval (0 = default
# 5s, matching docker), otherwise the regular interval.
run_due() {
  now=$(date +%s)
  next=0
  for duef in "$state"/*.due; do
    [ -e "$duef" ] || continue
    id=${duef%.*}; id=${id##*/}
    due=$(cat "$duef" 2>/dev/null || echo 0)
    if [ "$now" -ge "$due" ]; then
      if podman healthcheck run "$id" >/dev/null 2>&1; then
        touch "$state/$id.healthy"
      fi
      # shellcheck disable=SC2046  # intentional word splitting of meta fields
      set -- $(meta_of "$id")
      step=$1
      if [ ! -f "$state/$id.healthy" ] && [ "${4:-0}" -gt 0 ] \
         && [ $(( $(date +%s) - $4 )) -lt "${2:-0}" ]; then
        step=${3:-0}
        [ "$step" -gt 0 ] || step=5
      fi
      echo $(( $(date +%s) + step )) > "$duef"
      due=$(cat "$duef")
    fi
    if [ "$next" -eq 0 ] || [ "$due" -lt "$next" ]; then
      next=$due
    fi
  done
  echo "$next"
}

fifo=$state/events
start_events() {
  rm -f "$fifo"
  mkfifo "$fifo"
  podman events --filter type=container \
    --format '{{.Status}} {{.ID}}' > "$fifo" 2>/dev/null &
  evpid=$!
}

sync_all
start_events
# hold the fifo open for the lifetime of the loop so the events writer never
# blocks on open and we can read -t with a timeout against it
exec 9< "$fifo"

while :; do
  next=$(run_due)
  if [ "$next" -gt 0 ]; then
    wait=$(( next - $(date +%s) ))
    [ "$wait" -lt 1 ] && wait=1
    [ "$wait" -gt "$tick" ] && wait=$tick
  else
    wait=$tick
  fi
  # shellcheck disable=SC3045  # read -t: busybox ash, not strict POSIX
  if read -r -t "$wait" ev <&9; then
    # shellcheck disable=SC2086  # intentional word splitting of "status id"
    set -- $ev
    st=$1 id=${2:-}
    [ -n "$id" ] || continue
    case $st in
      # a (re)start resets podman's health status to "starting", so drop any
      # stale healthy marker and re-inspect: StartedAt/intervals may differ
      start)
        set -- "$(printf %.12s "$id")"
        rm -f "$state/$1.healthy" "$state/$1.meta"
        add_container "$1"
        ;;
      died|stop|kill|remove|prune) remove_container "$id" ;;
    esac
  elif ! kill -0 "$evpid" 2>/dev/null; then
    # events stream died: reopen and reconcile anything missed while it was down
    exec 9<&-
    start_events
    exec 9< "$fifo"
    sync_all
  elif [ $(( $(date +%s) - lastsync )) -ge "$tick" ]; then
    # fallback resync in case the events stream silently missed something
    sync_all
  fi
done
