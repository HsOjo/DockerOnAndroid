#!/bin/sh
# DockerOnAndroid netavark shim: implements the netavark CLI (v1.13, podman 5.3) on top of
# patched pasta instead of kernel veth/bridge. Podman drives everything:
#   setup <netns>    JSON on stdin -> state + aardvark records + result JSON
#   teardown <netns> -> kill pastas, drop records/aliases
# Non-bridge drivers and unknown commands delegate to netavark.real.
#
# setup only writes state and $STATE/<cid>.launch.sh; the conmon wrapper
# (usr/bin/conmon) runs it right after closing podman's port-reservation
# sockets, so pasta always starts with the published ports already free.
# The launch script resolves EXPOSE-only ports via podman inspect (blocks
# until the create transaction commits; it runs detached, so that is fine),
# then stays alive supervising one pasta per attached network.
#
# Limits: host port publishing lands on the first network;
# only the first non-internal network gets a default route (per family).
PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
PASTA=/usr/local/bin/pasta
REAL=
DEF_AAVARK=
for d in /usr/libexec/podman /usr/lib/podman; do
  [ -z "$REAL" ] && [ -f "$d/netavark.real" ] && REAL=$d/netavark.real
  [ -z "$DEF_AAVARK" ] && [ -f "$d/aardvark-dns" ] && DEF_AAVARK=$d/aardvark-dns
done
REAL=${REAL:-/usr/libexec/podman/netavark.real}
STATE=/tmp/pasta/nv
DEFAULT_DNS=223.5.5.5

CONFIG=/run/containers/networks
AAVARK=${DEF_AAVARK:-/usr/libexec/podman/aardvark-dns}
DNS_PORT=${NETAVARK_DNS_PORT:-53}
cmd=
nsf=
while [ $# -gt 0 ]; do
  case $1 in
    --config) CONFIG=$2; shift 2;;
    --rootless=*|--firewall-driver=*) shift;;
    --aardvark-binary=*) AAVARK=${1#*=}; shift;;
    --*) shift;;
    *) if [ -z "$cmd" ]; then cmd=$1; else nsf=$1; fi; shift;;
  esac
done

rotate() { # rotate <file> at 1MiB, keep one generation
  f=$1
  [ -f "$f" ] || return 0
  s=$(stat -c %s "$f" 2>/dev/null) || return 0
  [ "$s" -gt 1048576 ] && mv "$f" "$f.1" 2>/dev/null
  return 0
}
log() { rotate /tmp/nv-shim.log; echo "$(date '+%F %T') $*" >> /tmp/nv-shim.log; }

case $cmd in
  version)
    printf '{"version":"1.13.1-pasta","commit":"","target":"aarch64"}\n'
    exit 0;;
  update)
    cat > /dev/null
    printf '{}\n'
    exit 0;;
  firewall|firewalld_reload|dhcp-proxy)
    cat > /dev/null 2>/dev/null
    exit 0;;
  setup|teardown) :;;
  *) exec "$REAL" --config "$CONFIG" ${cmd:+$cmd} ${nsf:+$nsf};;
esac

[ -n "$nsf" ] || { echo "netavark-pasta: missing netns path" >&2; exit 1; }
in=$(cat)
mkdir -p "$STATE"
printf '%s' "$in" > "$STATE/last-$cmd.json" 2>/dev/null

cid=$(printf '%s' "$in" | jq -r '.container_id // empty')
cname=$(printf '%s' "$in" | jq -r '.container_name // empty')
[ -n "$cid" ] || { echo "netavark-pasta: no container_id" >&2; exit 1; }

# Delegate when any attached network is not bridge.
nonbridge=$(printf '%s' "$in" | jq -r '[.network_info[]?.driver] | map(select(. != "bridge")) | length' 2>/dev/null)
if [ "${nonbridge:-0}" != "0" ]; then
  printf '%s' "$in" | "$REAL" --config "$CONFIG" --aardvark-binary="$AAVARK" "$cmd" "$nsf"
  exit $?
fi

valid_ip4() { printf '%s' "$1" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; }
is_ip6() { case $1 in *:*) return 0;; *) return 1;; esac; }

# lo aliases: v4 /32 and v6 /128 (host-side bind targets for pasta and
# aardvark); $1=addr
lo_alias_add() {
  if is_ip6 "$1"; then
    ip -6 addr show dev lo 2>/dev/null | grep -q "$1/128" && return 0
    out=$(ip -6 addr add "$1/128" dev lo 2>&1) || log "lo_alias_add $1 FAILED: $out"
  else
    ip addr show dev lo 2>/dev/null | grep -q "$1/32" && return 0
    out=$(ip addr add "$1/32" dev lo 2>&1) || log "lo_alias_add $1 FAILED: $out"
  fi
}

lo_alias_del() {
  if is_ip6 "$1"; then ip -6 addr del "$1/128" dev lo 2>/dev/null
  else ip addr del "$1/32" dev lo 2>/dev/null; fi
}

aavark_dir=$CONFIG/aardvark-dns

aavark_notify() {
  pid=$(cat "$aavark_dir/aardvark.pid" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    kill -HUP "$pid" 2>/dev/null
    return 0
  fi
  [ -x "$AAVARK" ] || return 0
  rotate /tmp/nv-aardvark.log
  "$AAVARK" --config "$aavark_dir" -p "$DNS_PORT" run >> /tmp/nv-aardvark.log 2>&1 &
}

nets=$(printf '%s' "$in" | jq -r '.networks | to_entries[] | "\(.value.interface_name // "eth9") \(.key)"' 2>/dev/null | sort | awk '{print $2}')

aavark_file() { # $1=net $2=internal -> record file path
  f=$aavark_dir/$1
  [ "$2" = "true" ] && [ ! -f "$f" ] && f=$f%int
  printf '%s' "$f"
}

if [ "$cmd" = teardown ]; then
  log "teardown $cid ($cname)"
  for net in $nets; do
    dns_enabled=$(printf '%s' "$in" | jq -r ".network_info[\"$net\"].dns_enabled // false")
    internal=$(printf '%s' "$in" | jq -r ".network_info[\"$net\"].internal // false")
    [ "$dns_enabled" = "true" ] || continue
    f=$(aavark_file "$net" "$internal")
    [ -f "$f" ] || continue
    grep -v "^$cid " "$f" > "$f.tmp" 2>/dev/null; cat "$f.tmp" > "$f"; rm -f "$f.tmp"
    # only the gateway line left => last container on this network
    if [ "$(wc -l < "$f" 2>/dev/null)" -le 1 ]; then
      for gw in $(printf '%s' "$in" | jq -r ".network_info[\"$net\"].subnets[]?.gateway // empty"); do
        lo_alias_del "$gw"
      done
      rm -f "$f"
      # no record files left anywhere: stop aardvark instead of leaving it
      # bound to dead gateway addresses
      left=
      for rf in "$aavark_dir"/*; do
        [ -f "$rf" ] || continue
        case ${rf##*/} in aardvark.pid) continue;; esac
        left=1; break
      done
      if [ -z "$left" ]; then
        apid=$(cat "$aavark_dir/aardvark.pid" 2>/dev/null)
        [ -n "$apid" ] && kill "$apid" 2>/dev/null && rm -f "$aavark_dir/aardvark.pid"
      fi
    fi
    aavark_notify
  done
  pids=
  for p in "$STATE/$cid.pastapid".*; do
    [ -f "$p" ] || continue
    pids="$pids $(cat "$p" 2>/dev/null)"
  done
  aliases=$(cat "$STATE/$cid.ip" 2>/dev/null)
  # unpin a materialized netns bind mount (see setup) before wiping state
  if [ -f "$STATE/$cid.netns" ]; then
    umount "$STATE/$cid.netns" 2>/dev/null || umount -l "$STATE/$cid.netns" 2>/dev/null
  fi
  # remove state first: the launch.sh supervisor polls for it and exits
  rm -f "$STATE/$cid".*
  # /tmp survives reboots here: stale pastapids may belong to reused PIDs,
  # only kill processes that actually are pasta
  for pp in $pids; do
    case $(tr '\0' ' ' < "/proc/$pp/cmdline" 2>/dev/null) in *pasta*) kill "$pp" 2>/dev/null;; esac
  done
  # pasta holds the published ports until it exits, and podman re-binds them
  # the moment teardown returns (restart = stop+start back to back) — a slow
  # pasta shutdown fails the next start with EADDRINUSE. Wait for exit
  # (zombie counts as dead: sockets are already released), escalating to
  # SIGKILL after a grace period; bounded at ~5s total.
  alive=
  i=0
  while [ "$i" -lt 40 ]; do
    alive=
    for pp in $pids; do
      [ -d "/proc/$pp" ] || continue
      grep -q "^State:.*Z" "/proc/$pp/status" 2>/dev/null && continue
      alive="$alive $pp"
    done
    [ -z "$alive" ] && break
    sleep 0.05; i=$((i+1))
  done
  if [ -n "$alive" ]; then
    for pp in $alive; do kill -9 "$pp" 2>/dev/null; done
    i=0
    while [ "$i" -lt 60 ] && [ -n "$alive" ]; do
      alive=
      for pp in $pids; do
        [ -d "/proc/$pp" ] || continue
        grep -q "^State:.*Z" "/proc/$pp/status" 2>/dev/null && continue
        alive="$alive $pp"
      done
      [ -z "$alive" ] && break
      sleep 0.05; i=$((i+1))
    done
    [ -n "$alive" ] && log "teardown $cid pasta$alive still alive after SIGKILL"
  fi
  for a in $aliases; do
    lo_alias_del "$a"
  done
  exit 0
fi

# ---- setup ----
nnets=$(printf '%s\n' "$nets" | grep -c .)
log "setup $cid ($cname) nets=$(printf '%s' "$nets" | tr '\n' ',') nsf=$nsf"

# pasta opens /dev/net/tun with dropped caps (egid aid_inet); Android creates
# the node 1000:1016 0660, which survives only until reboot. Only needed when
# configure probed the kernel's paranoid-network check on (INET_GID set).
if [ -n "@INET_GID@" ] && [ -c /dev/net/tun ]; then
  chgrp @INET_GID@ /dev/net/tun 2>/dev/null; chmod 660 /dev/net/tun 2>/dev/null
fi
runas=; [ -n "@INET_GID@" ] && runas="--runas 0:@INET_GID@"

# buildah hands us a transient /proc/<pid>/fd/<n> netns reference that it
# closes as soon as setup returns; the pasta launch is asynchronous and would
# find the path gone ("Couldn't open network namespace ..."). Pin the netns
# with a bind mount while the fd is still valid; teardown umounts it.
case $nsf in
  /proc/*/fd/*)
    stable=$STATE/$cid.netns
    : > "$stable"
    if mount --bind "$nsf" "$stable" 2>/dev/null; then
      log "setup $cid pinned transient netns $nsf"
      nsf=$stable
    else
      rm -f "$stable"
      log "setup $cid could not pin transient netns $nsf"
    fi
    ;;
esac

dev=$(ip route get "$DEFAULT_DNS" 2>/dev/null | sed -n 's/.*dev \([^ ]*\).*/\1/p' | head -1)

# published ports -> host bindings (docker semantics, incl. host_ip + ranges);
# they land on the first network's pasta
pubargs=
cpublished=
cequal=
pmf=$STATE/$cid.pm
printf '%s' "$in" | jq -c '.port_mappings[]? // empty' > "$pmf" 2>/dev/null
while IFS= read -r pm; do
  [ -n "$pm" ] || continue
  cp=$(printf '%s' "$pm" | jq -r '.container_port // 0')
  hp=$(printf '%s' "$pm" | jq -r '.host_port // 0')
  hip=$(printf '%s' "$pm" | jq -r '.host_ip // ""')
  range=$(printf '%s' "$pm" | jq -r '.range // 1')
  protos=$(printf '%s' "$pm" | jq -r '.protocol // "tcp"' | tr ',' ' ')
  [ "$cp" -gt 0 ] 2>/dev/null || continue
  [ "$hp" -gt 0 ] 2>/dev/null || hp=$cp
  i=0
  while [ "$i" -lt "${range:-1}" ]; do
    for pr in $protos; do
      case $pr in
        udp) t=u;;
        tcp) t=t;;
        *) continue;;
      esac
      hpi=$((hp+i)); cpi=$((cp+i))
      if valid_ip4 "$hip"; then
        pubargs="$pubargs -$t $hip/$hpi:$cpi"
      elif is_ip6 "$hip"; then
        pubargs="$pubargs -$t [$hip]/$hpi:$cpi"
      else
        pubargs="$pubargs -$t $hpi:$cpi"
      fi
      cpublished="$cpublished $t:$cpi"
      # wildcard publishes with hp==cp already cover the container address;
      # a cip-direct twin ([cip]:cp vs [*]:cp) collides in pasta's forward
      # table and kills it, so those ports skip the cip-direct rules below
      if [ "$hpi" = "$cpi" ]; then
        case $hip in ""|0.0.0.0|::) cequal="$cequal $t:$cpi";; esac
      fi
    done
    i=$((i+1))
  done
done < "$pmf"
rm -f "$pmf"

first=1
gwflag_done=
: > "$STATE/$cid.ip"
result_frags=
for net in $nets; do
  info=$(printf '%s' "$in" | jq -c ".network_info[\"$net\"] // {}")
  pernet=$(printf '%s' "$in" | jq -c ".networks[\"$net\"] // {}")
  dns_enabled=$(printf '%s' "$info" | jq -r '.dns_enabled // false')
  internal=$(printf '%s' "$info" | jq -r '.internal // false')
  # addresses/subnets are per-family lists; match by family
  cip4=$(printf '%s' "$pernet" | jq -r '[.static_ips[]? | select(contains(":") | not)] | .[0] // empty')
  cip6=$(printf '%s' "$pernet" | jq -r '[.static_ips[]? | select(contains(":"))] | .[0] // empty')
  subnet4=$(printf '%s' "$info" | jq -r '[.subnets[]? | select(.subnet | contains(":") | not)] | .[0].subnet // empty')
  gw4=$(printf '%s' "$info" | jq -r '[.subnets[]? | select(.subnet | contains(":") | not)] | .[0].gateway // empty')
  subnet6=$(printf '%s' "$info" | jq -r '[.subnets[]? | select(.subnet | contains(":"))] | .[0].subnet // empty')
  gw6=$(printf '%s' "$info" | jq -r '[.subnets[]? | select(.subnet | contains(":"))] | .[0].gateway // empty')
  smac=$(printf '%s' "$pernet" | jq -r '.static_mac // empty')
  ifn=$(printf '%s' "$pernet" | jq -r '.interface_name // empty')
  if ! valid_ip4 "$cip4" && ! is_ip6 "$cip6"; then
    echo "netavark-pasta: no usable static_ips for $cid on $net" >&2
    exit 1
  fi
  [ -n "$ifn" ] || ifn=eth$((first-1))
  [ -n "$cip4" ] && { valid_ip4 "$gw4" || gw4=${cip4%.*}.1; }
  prefix4=${subnet4#*/}
  case $prefix4 in *[!0-9]*|""|*.*) prefix4=24;; esac
  [ -n "$cip4" ] || prefix4=
  prefix6=${subnet6#*/}
  case $prefix6 in *[!0-9]*) prefix6=64;; esac
  [ -n "$cip6" ] || prefix6=
  [ -z "$smac" ] && smac=$(printf '%s' "$cid$net" | md5sum | sed 's/^\(..\)\(..\)\(..\)\(..\).*$/9a:55:\1:\2:\3:\4/')

  # default route only on the first non-internal network (per family); pasta
  # copies the template gateway/LAN routes when -g is omitted, so units
  # without -g get a post-config route flush (noroute). Non-internal
  # secondary units additionally get source-based policy routing (tid) so
  # replies egress the interface the traffic arrived on.
  gwflag4=
  gwflag6=
  noroute=
  tid=
  if [ "$internal" != "true" ] && [ -z "$gwflag_done" ]; then
    [ -n "$gw4" ] && gwflag4="-g $gw4"
    is_ip6 "$gw6" && gwflag6="-g $gw6"
    gwflag_done=1
  fi
  if [ -z "$gwflag4" ] && [ -z "$gwflag6" ]; then
    noroute=1
    [ "$internal" = "true" ] || tid=$((100+first))
  fi

  # host-side aliases: container IPs (direct access) always; gateways only
  # when aardvark DNS needs a bind target (teardown removes them under the
  # same condition)
  for a in "$cip4" "$cip6"; do
    [ -n "$a" ] && lo_alias_add "$a"
  done
  if [ "$dns_enabled" = "true" ]; then
    for a in "$gw4" "$gw6"; do
      [ -n "$a" ] && lo_alias_add "$a"
    done
  fi
  [ -n "$cip4" ] && printf '%s\n' "$cip4" >> "$STATE/$cid.ip"
  [ -n "$cip6" ] && printf '%s\n' "$cip6" >> "$STATE/$cid.ip"

  # per-network pasta args: cip-direct rules for published container ports
  # (same-network peers reach them via the container address)
  args=
  [ "$first" = 1 ] && args=$pubargs
  seen=
  for e in $cpublished; do
    case " $seen " in *" $e "*) continue;; esac
    seen="$seen $e"
    pr=${e%%:*}; cp=${e#*:}
    [ -n "$cp" ] || continue
    if [ "$first" = 1 ]; then
      case " $cequal " in *" $pr:$cp "*) continue;; esac
    fi
    [ -n "$cip4" ] && args="$args -$pr $cip4/$cp:$cp"
    [ -n "$cip6" ] && args="$args -$pr [$cip6]/$cp:$cp"
  done
  printf '%s\n' "$args" | sed 's/^ //' > "$STATE/$cid.pastaargs.$net"
  ucequal=
  [ "$first" = 1 ] && ucequal=$cequal
  cat > "$STATE/$cid.unit.$net" <<EOF
ifn="$ifn" cip4="$cip4" cip6="$cip6" prefix4="$prefix4" gw4="$gw4" gw6="$gw6" gwflag4="$gwflag4" gwflag6="$gwflag6" smac="$smac" dev="$dev" noroute="$noroute" tid="$tid" cequal="$ucequal"
EOF

  if [ "$dns_enabled" = "true" ]; then
    mkdir -p "$aavark_dir"
    f=$(aavark_file "$net" "$internal")
    # aardvark format: first line = comma-separated bind IPs; record lines =
    # "<id> <v4> <v6> <names>" (single space per field, empty field = none)
    if [ ! -f "$f" ]; then
      gws=$gw4
      [ -n "$gw6" ] && gws="${gws:+$gws,}$gw6"
      printf '%s\n' "$gws" > "$f"
    fi
    names=$cname
    for a in $(printf '%s' "$pernet" | jq -r '.aliases[]? // empty'); do
      case ,$names, in *,$a,*) :;; *) names="$names,$a";; esac
    done
    # aardvark serves record names verbatim; netavark >= 1.16 writes
    # explicit FQDN entries (podman 5.7), older ones derived the zone
    # themselves - append <name>.<net> so both resolve
    fq=
    for n in $(printf '%s' "$names" | tr ',' ' '); do fq="$fq,$n,$n.$net"; done
    names=${fq#,}
    grep -v "^$cid " "$f" > "$f.tmp" 2>/dev/null; cat "$f.tmp" > "$f"; rm -f "$f.tmp"
    printf '%s %s %s %s\n' "$cid" "$cip4" "$cip6" "$names" >> "$f"
  fi

  if [ "$dns_enabled" = "true" ]; then
    dnsjson=$(jq -n --arg a "$gw4" --arg b "$gw6" '[$a, $b] | map(select(. != ""))')
  else dnsjson="null"; fi
  snjson=$(jq -n --arg gw4 "$gw4" --arg ip4 "${cip4:+$cip4/$prefix4}" --arg gw6 "$gw6" --arg ip6 "${cip6:+$cip6/$prefix6}" \
    '[[$gw4, $ip4], [$gw6, $ip6]] | map(select(.[0] != "" and .[1] != "")) | map({gateway: .[0], ipnet: .[1]})')
  frag=$STATE/$cid.frag.$net
  jq -n --arg net "$net" --arg ifn "$ifn" --arg mac "$smac" --argjson dns "$dnsjson" --argjson subnets "$snjson" \
    '{($net): {dns_search_domains: null, dns_server_ips: $dns, interfaces: {($ifn): {mac_address: $mac, subnets: $subnets}}}}' > "$frag"
  result_frags="$result_frags $frag"
  [ "$dns_enabled" = "true" ] && any_dns=1
  first=$((first+1))
done
[ -n "$any_dns" ] && aavark_notify

# The conmon wrapper runs this script after closing podman's
# port-reservation sockets.
printf '%s' "$nsf" > "$STATE/$cid.nsf"
cat > "$STATE/$cid.launch.sh" <<EOF
#!/bin/sh
STATE="$STATE"; cid="$cid"; nsf="$nsf"; PASTA="$PASTA"
EOF
cat >> "$STATE/$cid.launch.sh" <<'LAUNCH_EOF'
# readiness gate: the conmon wrapper holds container start until $cid.ready
# appears (netns configured) or a timeout passes, so an entrypoint that uses
# the network immediately never sees a half-configured namespace
rm -f "$STATE/$cid.ready"

# one supervisor per container: a relaunch (network reload) while the old
# supervisor is alive must not spawn a second one; the lock lives outside
# the teardown wipe pattern ($cid.*) so the same inode is locked throughout;
# pasta closes fd 9
exec 9>"$STATE/lock-$cid"
if ! flock -n 9 2>/dev/null; then
  # a surviving supervisor (restart gap) owns the relaunch and signals
  # readiness itself; just wait for it
  i=0
  while [ "$i" -lt 200 ] && [ ! -f "$STATE/$cid.ready" ]; do sleep 0.05; i=$((i+1)); done
  exit 0
fi

log=$STATE/$cid.log
[ -f "$log" ] && [ "$(stat -c %s "$log" 2>/dev/null)" -gt 1048576 ] 2>/dev/null && mv "$log" "$log.1"

# EXPOSE set without podman inspect (it blocks on the container lock until
# the create transaction commits): containers.json maps cid -> image id and
# the image config blob (filename is base64 of the config digest; busybox
# base64 wraps at 76 cols, hence tr) holds config.ExposedPorts. The first
# pasta pass therefore already carries the EXPOSE rules, so no restart
# window opens after readiness; the inspect-based second pass below stays
# as a fallback (extra --expose flags, storage layout changes)
exp=
GROOT=/var/lib/containers/storage
# podman run keeps the create transaction open through start, so under run
# the containers.json entry is invisible until start-commit and this read
# finds nothing (the inspect-based second pass then restarts pasta with the
# rules); standalone create+start commits early and the first pass already
# carries the EXPOSE rules, so no restart window opens after readiness
iid=$(jq -r --arg c "$cid" '.[] | select(.id == $c) | .image' \
  "$GROOT/overlay-containers/containers.json" 2>/dev/null)
if [ -n "$iid" ]; then
  cblob=$GROOT/overlay-images/$iid/=$(printf %s "sha256:$iid" | base64 | tr -d '\n')
  [ -f "$cblob" ] && \
    exp=$(jq -r '(.config.ExposedPorts // .Config.ExposedPorts // {}) | keys | join(" ")' "$cblob" 2>/dev/null)
fi

start_unit() { # $1=net
  un=$1
  . "$STATE/$cid.unit.$un"
  set -- $(cat "$STATE/$cid.pastaargs.$un" 2>/dev/null)
  for pe in $exp; do
    pp=${pe%%/*}; pr=${pe#*/}
    [ "$pp" -gt 0 ] 2>/dev/null || continue
    case $pr in udp) t=u;; *) t=t;; esac
    # wildcard-published with hp==cp: a cip rule would collide in pasta
    case " $cequal " in *" $t:$pp "*) continue;; esac
    if [ -n "$cip4" ]; then
      case " $* " in *" $cip4/$pp:$pp "*) :;; *) set -- "$@" -$t "$cip4/$pp:$pp";; esac
    fi
    if [ -n "$cip6" ]; then
      case " $* " in *" [$cip6]/$pp:$pp "*) :;; *) set -- "$@" -$t "[$cip6]/$pp:$pp";; esac
    fi
  done
  i=0
  while [ "$i" -lt 6 ]; do
    # shellcheck disable=SC2086 # intentional: ${var:+...} word pairs, $runas is two words
    "$PASTA" -f --config-net $runas --chroot-fallback --no-map-gw \
      -T none -U none -I "$ifn" \
      ${dev:+--interface "$dev"} ${cip4:+-a "$cip4"} ${prefix4:+-n "$prefix4"} $gwflag4 \
      ${cip6:+-a "$cip6"} $gwflag6 \
      "$@" --netns "$nsf" >> "$log" 2>&1 9>&- &
    pp=$!
    # poll instead of a fixed grace second: pasta exits within milliseconds
    # on config errors, and ~0.3s alive is proof enough (the supervise loop
    # covers late crashes anyway)
    j=0
    while [ "$j" -lt 6 ]; do
      sleep 0.05
      kill -0 "$pp" 2>/dev/null || break
      j=$((j+1))
    done
    if kill -0 "$pp" 2>/dev/null; then
      echo "$pp" > "$STATE/$cid.pastapid.$un"
      # effective args (base + EXPOSE): the second pass diffs against these,
      # not the base pastaargs file, so an unchanged EXPOSE set means no
      # restart
      printf '%s\n' "$*" > "$STATE/$cid.curargs.$un"
      return 0
    fi
    i=$((i+1)); sleep 0.5
  done
  return 1
}

fixns_unit() { # $1=net
  . "$STATE/$cid.unit.$1"
  i=0
  while [ "$i" -lt 100 ]; do
    nsenter --net="$nsf" ip link show "$ifn" >/dev/null 2>&1 && break
    i=$((i+1)); sleep 0.05
  done
  nsenter --net="$nsf" ip link set lo up 2>/dev/null
  nsenter --net="$nsf" ip link set "$ifn" address "$smac" 2>/dev/null
  if [ "$noroute" = 1 ]; then
    if [ -n "$cip4" ]; then
      # drop all v4 routes except the container's own connected route
      nsenter --net="$nsf" ip route show dev "$ifn" 2>/dev/null | grep -v "src $cip4" | while read -r r; do
        [ -n "$r" ] && nsenter --net="$nsf" ip route del $r 2>/dev/null
      done
    else
      # no v4 on this net: template v4 addresses are useless off the primary
      # network (flushing the addr also drops its connected route)
      nsenter --net="$nsf" ip addr flush dev "$ifn" scope global 2>/dev/null
    fi
    if [ -n "$cip6" ]; then
      # keep the connected v6 subnet route: in-net connectivity, and the
      # policy-routing table entry needs the gateway to be reachable
      nsenter --net="$nsf" ip -6 route show dev "$ifn" 2>/dev/null | grep "default" | while read -r r; do
        [ -n "$r" ] && nsenter --net="$nsf" ip -6 route del $r 2>/dev/null
      done
    else
      nsenter --net="$nsf" ip -6 addr flush dev "$ifn" scope global 2>/dev/null
      nsenter --net="$nsf" ip -6 route show dev "$ifn" 2>/dev/null | grep -v "fe80:" | while read -r r; do
        [ -n "$r" ] && nsenter --net="$nsf" ip -6 route del $r 2>/dev/null
      done
    fi
  fi
  if [ -n "$tid" ]; then
    if [ -n "$cip4" ]; then
      nsenter --net="$nsf" ip rule 2>/dev/null | grep -q "from $cip4" || \
        nsenter --net="$nsf" ip rule add from "$cip4" table "$tid" 2>/dev/null
      nsenter --net="$nsf" ip route add default via "$gw4" dev "$ifn" table "$tid" 2>/dev/null
    fi
    if [ -n "$cip6" ]; then
      nsenter --net="$nsf" ip -6 rule 2>/dev/null | grep -q "from $cip6" || \
        nsenter --net="$nsf" ip -6 rule add from "$cip6" table "$tid" 2>/dev/null
      nsenter --net="$nsf" ip -6 route add default via "$gw6" dev "$ifn" table "$tid" 2>/dev/null
    fi
  fi
}

# extra args the EXPOSE set would add on top of what the running pasta was
# started with (curargs, falling back to the base pastaargs file); empty
# when the running pasta already covers everything
exp_args() {
  ea_net=$1
  . "$STATE/$cid.unit.$ea_net"
  set -- $(cat "$STATE/$cid.curargs.$ea_net" 2>/dev/null || cat "$STATE/$cid.pastaargs.$ea_net" 2>/dev/null)
  ea_out=
  for pe in $exp; do
    pp=${pe%%/*}; pr=${pe#*/}
    [ "$pp" -gt 0 ] 2>/dev/null || continue
    case $pr in udp) t=u;; *) t=t;; esac
    case " $cequal " in *" $t:$pp "*) continue;; esac
    if [ -n "$cip4" ]; then
      case " $* " in *" $cip4/$pp:$pp "*) :;; *) ea_out="$ea_out -$t $cip4/$pp:$pp";; esac
    fi
    if [ -n "$cip6" ]; then
      case " $* " in *" [$cip6]/$pp:$pp "*) :;; *) ea_out="$ea_out -$t [$cip6]/$pp:$pp";; esac
    fi
  done
  printf '%s' "$ea_out"
}

# first pass, exp still empty: netns base config only, then signal readiness
for u in "$STATE/$cid.unit".*; do
  [ -f "$u" ] || continue
  n=${u##*.}
  start_unit "$n" || { echo "$(date '+%F %T') launch $cid $n pasta gave up" >> /tmp/nv-shim.log; continue; }
  fixns_unit "$n"
  echo "$(date '+%F %T') launch $cid $n pasta up pid=$(cat "$STATE/$cid.pastapid.$n" 2>/dev/null)" >> /tmp/nv-shim.log
done
: > "$STATE/$cid.ready"

# state may have been wiped (container stopped) while we worked
[ -f "$STATE/$cid.ip" ] || { rm -f "$STATE/lock-$cid"; exit 0; }

# second pass: EXPOSE rules, now that inspect can commit; restart the pastas
# whose arg list actually grows
exp=$(/usr/bin/podman.real inspect -f '{{range $p,$_ := .Config.ExposedPorts}}{{$p}} {{end}}' "$cid" 2>/dev/null)
for u in "$STATE/$cid.unit".*; do
  [ -f "$u" ] || continue
  n=${u##*.}
  [ -n "$(exp_args "$n")" ] || continue
  pp=$(cat "$STATE/$cid.pastapid.$n" 2>/dev/null)
  case $(tr '\0' ' ' < "/proc/$pp/cmdline" 2>/dev/null) in *pasta*) kill "$pp" 2>/dev/null;; esac
  start_unit "$n" || continue
  fixns_unit "$n"
  echo "$(date '+%F %T') launch $cid $n pasta restarted with EXPOSE rules pid=$(cat "$STATE/$cid.pastapid.$n" 2>/dev/null)" >> /tmp/nv-shim.log
done

while :; do
  # 1s cadence: a pasta that died on the startup port race (podman releases
  # its reservation copies only at start commit) must be retried promptly —
  # at 5s the docker "published port works right after run" window is easily
  # exceeded on slow/loaded devices
  sleep 1
  [ -f "$STATE/$cid.ip" ] || { rm -f "$STATE/lock-$cid"; exit 0; }
  # follow container restarts: a restart rewrites state with a new netns
  # while this supervisor (flock holder) may survive the teardown gap;
  # re-read the netns so pasta is (re)launched against the current one
  [ -f "$STATE/$cid.nsf" ] && nsf=$(cat "$STATE/$cid.nsf" 2>/dev/null)
  # iterate unit files (not pastapid files): teardown wipes pastapids, and
  # on a network reload the surviving supervisor must revive pasta from scratch
  for u in "$STATE/$cid.unit".*; do
    [ -f "$u" ] || continue
    n=${u##*.}
    pp=$(cat "$STATE/$cid.pastapid.$n" 2>/dev/null)
    [ -n "$pp" ] && kill -0 "$pp" 2>/dev/null && continue
    start_unit "$n" || continue
    fixns_unit "$n"
    # restart-gap gating: a relaunch during container restart re-signals
    # readiness for the conmon wrapper waiting on the new netns
    : > "$STATE/$cid.ready"
    echo "$(date '+%F %T') supervise $cid $n pasta relaunched pid=$(cat "$STATE/$cid.pastapid.$n" 2>/dev/null)" >> /tmp/nv-shim.log
  done
done
LAUNCH_EOF
chmod +x "$STATE/$cid.launch.sh"

# Self-launch pasta right after setup when conmon doesn't have to fire:
# - network reload: teardown+setup on a *live* container never involves
#   conmon, so nothing else would run the launch script
# - no published ports: podman holds no reservation sockets for this
#   container, so pasta may bind immediately and configure the netns in
#   parallel with podman's spec/rootfs work; the conmon wrapper then only
#   waits on the ready flag instead of triggering the launch itself
# With published ports pasta must wait for the conmon wrapper to close
# podman's reservation sockets first.
# One ls+grep for the whole /proc scan: a readlink per pid costs seconds on
# Android-scale process counts
nsino=$(stat -Lc %i "$nsf" 2>/dev/null || echo _)
live=
case $(ls -l /proc/[0-9]*/ns/net 2>/dev/null | grep -m1 "net:\[$nsino\]") in
  ?*) live=1;;
esac
if [ -f "$STATE/$cid.launch.sh" ]; then
  early=
  if [ -n "$live" ]; then
    log "setup $cid netns already live (network reload); self-launching pasta"
    early=1
  elif [ -z "$pubargs" ]; then
    log "setup $cid no published ports; early self-launch"
    early=1
  fi
  if [ -n "$early" ]; then
    mv "$STATE/$cid.launch.sh" "$STATE/$cid.launch.run"
    setsid sh "$STATE/$cid.launch.run" </dev/null >/dev/null 2>&1 &
    # there is no conmon to gate on the ready flag in this path (buildah RUN
    # steps hit the network the instant setup returns), so wait for pasta to
    # finish the first configuration pass here
    i=0
    while [ "$i" -lt 100 ] && [ ! -f "$STATE/$cid.ready" ]; do sleep 0.05; i=$((i+1)); done
  fi
fi

# shellcheck disable=SC2086 # intentional word splitting: frag list
set -- $result_frags
jq -s 'add // {}' "$@"
rc=$?
rm -f "$@"
[ "$rc" = 0 ] || { echo "netavark-pasta: failed to build result" >&2; exit 1; }
log "setup $cid done nets=$nnets"
exit 0
